  "ayahs": [
    {
      "surahNumber": 1,
      "ayahNumber": 1,
      "verseKey": "1:1",
      "arabicText": "بِسْمِ اللّٰهِ الرَّحْمٰنِ الرَّحِيْمِ",
      "translationId": "Dengan nama Allah Yang Maha Pengasih, Maha Penyayang."
    },
    {
      "surahNumber": 1,
      "ayahNumber": 2,
      "verseKey": "1:2",
      "arabicText": "اَلْحَمْدُ لِلّٰهِ رَبِّ الْعٰلَمِيْنَۙ",
      "translationId": "Segala puji bagi Allah, Tuhan seluruh alam."
    },
    {
      "surahNumber": 1,
      "ayahNumber": 3,
      "verseKey": "1:3",
      "arabicText": "الرَّحْمٰنِ الرَّحِيْمِۙ",
      "translationId": "Yang Maha Pengasih, Maha Penyayang."
    },
    {
      "surahNumber": 1,
      "ayahNumber": 4,
      "verseKey": "1:4",
      "arabicText": "مٰلِكِ يَوْمِ الدِّيْنِۗ",
      "translationId": "Pemilik hari pembalasan."
    },
    {
      "surahNumber": 1,
      "ayahNumber": 5,
      "verseKey": "1:5",
      "arabicText": "اِيَّاكَ نَعْبُدُ وَاِيَّاكَ نَسْتَعِيْنُۗ",
      "translationId": "Hanya kepada Engkaulah kami menyembah dan hanya kepada Engkaulah kami mohon pertolongan."
    },
    {
      "surahNumber": 1,
      "ayahNumber": 6,
      "verseKey": "1:6",
      "arabicText": "اِهْدِنَا الصِّرَاطَ الْمُسْتَقِيْمَۙ",
      "translationId": "Tunjukilah kami jalan yang lurus."
    },
    {
      "surahNumber": 1,
      "ayahNumber": 7,
      "verseKey": "1:7",
      "arabicText": "صِرَاطَ الَّذِيْنَ اَنْعَمْتَ عَلَيْهِمْ ەۙ غَيْرِ الْمَغْضُوْبِ عَلَيْهِمْ وَلَا الضَّاۤلِّيْنَ ࣖ",
      "translationId": "(Yaitu) jalan orang-orang yang telah Engkau beri nikmat kepadanya; bukan jalan mereka yang dimurkai, dan bukan pula jalan mereka yang sesat."
    },
    {
      "surahNumber": 2,
      "ayahNumber": 1,
      "verseKey": "2:1",
      "arabicText": "الۤمّۤ ۚ",
      "translationId": "Alif Lam Mim."
    },
    {
      "surahNumber": 2,
      "ayahNumber": 2,
      "verseKey": "2:2",
      "arabicText": "ذٰلِكَ الْكِتٰبُ لَا رَيْبَ ۛ فِيْهِ ۛ هُدًى لِّلْمُتَّقِيْنَۙ",
      "translationId": "Kitab (Al-Qur'an) ini tidak ada keraguan padanya; petunjuk bagi mereka yang bertakwa."
    },
    {
      "surahNumber": 2,
      "ayahNumber": 3,
      "verseKey": "2:3",
      "arabicText": "الَّذِيْنَ يُؤْمِنُوْنَ بِالْغَيْبِ وَيُقِيْمُوْنَ الصَّلٰوةَ وَمِمَّا رَزَقْنٰهُمْ يُنْفِقُوْنَ ۙ",
      "translationId": "(Yaitu) mereka yang beriman kepada yang gaib, melaksanakan salat, dan menginfakkan sebagian rezeki yang Kami berikan kepada mereka."
    },
    {
      "surahNumber": 2,
      "ayahNumber": 4,
      "verseKey": "2:4",
      "arabicText": "وَالَّذِيْنَ يُؤْمِنُوْنَ بِمَآ اُنْزِلَ اِلَيْكَ وَمَآ اُنْزِلَ مِنْ قَبْلِكَ ۚ وَبِالْاٰخِرَةِ هُمْ يُوْقِنُوْنَۗ",
      "translationId": "Dan mereka yang beriman kepada yang diturunkan kepadamu dan yang telah diturunkan sebelum engkau, dan mereka yakin akan adanya akhirat."
    },
    {
      "surahNumber": 2,
      "ayahNumber": 5,
      "verseKey": "2:5",
      "arabicText": "اُولٰۤىِٕكَ عَلٰى هُدًى مِّنْ رَّبِّهِمْ ۙ وَاُولٰۤىِٕكَ هُمُ الْمُفْلِحُوْنَ",
      "translationId": "Merekalah yang mendapat petunjuk dari Tuhannya, dan mereka itulah orang-orang yang beruntung."
    },
    {
      "surahNumber": 2,
      "ayahNumber": 6,
      "verseKey": "2:6",
      "arabicText": "اِنَّ الَّذِيْنَ كَفَرُوْا سَوَاۤءٌ عَلَيْهِمْ ءَاَنْذَرْتَهُمْ اَمْ لَمْ تُنْذِرْهُمْ لَا يُؤْمِنُوْنَ",
      "translationId": "Sesungguhnya orang-orang kafir, sama saja bagi mereka, engkau beri peringatan atau tidak engkau beri peringatan, mereka tidak akan beriman."
    },
    {
      "surahNumber": 2,
      "ayahNumber": 7,
      "verseKey": "2:7",
      "arabicText": "خَتَمَ اللّٰهُ عَلٰى قُلُوْبِهِمْ وَعَلٰى سَمْعِهِمْ ۗ وَعَلٰٓى اَبْصَارِهِمْ غِشَاوَةٌ وَّلَهُمْ عَذَابٌ عَظِيْمٌ ࣖ",
      "translationId": "Allah telah mengunci hati dan pendengaran mereka, penglihatan mereka telah tertutup, dan mereka akan mendapat azab yang berat."
    },
    {
      "surahNumber": 2,
      "ayahNumber": 8,
      "verseKey": "2:8",
      "arabicText": "وَمِنَ النَّاسِ مَنْ يَّقُوْلُ اٰمَنَّا بِاللّٰهِ وَبِالْيَوْمِ الْاٰخِرِ وَمَا هُمْ بِمُؤْمِنِيْنَۘ",
      "translationId": "Dan di antara manusia ada yang berkata, “Kami beriman kepada Allah dan hari akhir,” padahal sesungguhnya mereka itu bukanlah orang-orang yang beriman."
    },
    {
      "surahNumber": 2,
      "ayahNumber": 9,
      "verseKey": "2:9",
      "arabicText": "يُخٰدِعُوْنَ اللّٰهَ وَالَّذِيْنَ اٰمَنُوْا ۚ وَمَا يَخْدَعُوْنَ اِلَّآ اَنْفُسَهُمْ وَمَا يَشْعُرُوْنَۗ",
      "translationId": "Mereka menipu Allah dan orang-orang yang beriman, padahal mereka hanyalah menipu diri sendiri tanpa mereka sadari."
    },
    {
      "surahNumber": 2,
      "ayahNumber": 10,
      "verseKey": "2:10",
      "arabicText": "فِيْ قُلُوْبِهِمْ مَّرَضٌۙ فَزَادَهُمُ اللّٰهُ مَرَضًاۚ وَلَهُمْ عَذَابٌ اَلِيْمٌ ۢ ەۙ بِمَا كَانُوْا يَكْذِبُوْنَ",
      "translationId": "Dalam hati mereka ada penyakit, lalu Allah menambah penyakitnya itu; dan mereka mendapat azab yang pedih karena mereka berdusta."
    }
  ]
